---
import { company } from '../data/company';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/projects', label: 'Projects' },
  { href: '/areas', label: 'Areas' },
  { href: '/contact', label: 'Contact' },
];

function isActive(href: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${company.name} home`}>
      <span class="brand-drop" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
          <path
            d="M12 2C8 9 4 12.5 4 16a8 8 0 0016 0c0-3.5-4-7-8-14z"
            fill="currentColor"></path>
        </svg>
      </span>
      <span class="brand-name">{company.name}</span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <span class="sr-only">Menu</span>
      <span class="burger" aria-hidden="true"></span>
    </button>

    <nav class="site-nav" id="site-nav" data-nav aria-label="Main">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[{ active: isActive(link.href) }]}
                aria-current={isActive(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn-yellow header-cta" href={`tel:${company.phones[0].tel}`}>
        Free quote
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(30, 96, 210, 0.96);
    backdrop-filter: blur(10px);
    color: white;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .header-inner {
    min-height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: white;
    font-weight: 900;
    font-size: 1.2rem;
  }

  .brand:hover {
    color: white;
  }

  .brand-drop {
    color: var(--yellow);
    display: grid;
    place-items: center;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .site-nav ul {
    display: flex;
    gap: 0.35rem;
  }

  .site-nav a {
    text-decoration: none;
    color: rgba(255, 255, 255, 0.92);
    font-weight: 700;
    padding: 0.45rem 0.7rem;
    border-radius: 999px;
  }

  .site-nav a:hover,
  .site-nav a.active {
    background: rgba(255, 255, 255, 0.14);
    color: white;
  }

  .header-cta {
    min-height: 2.5rem;
    padding: 0.45rem 1rem;
    font-size: 0.95rem;
  }

  .nav-toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.14);
    color: white;
    cursor: pointer;
  }

  .burger,
  .burger::before,
  .burger::after {
    display: block;
    width: 1.15rem;
    height: 2px;
    background: white;
    margin: 0 auto;
    position: relative;
    transition: transform 0.2s ease;
  }

  .burger::before,
  .burger::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .burger::before {
    top: -6px;
  }

  .burger::after {
    top: 6px;
  }

  @media (max-width: 900px) {
    .nav-toggle {
      display: grid;
      place-items: center;
    }

    .site-nav {
      position: absolute;
      inset: var(--header-h) 0 auto;
      background: var(--blue-deep);
      flex-direction: column;
      align-items: stretch;
      padding: 1rem 1.25rem 1.25rem;
      gap: 0.75rem;
      display: none;
      box-shadow: var(--shadow);
    }

    .site-nav.open {
      display: flex;
    }

    .site-nav ul {
      flex-direction: column;
    }

    .header-cta {
      width: 100%;
    }
  }
</style>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const nav = document.querySelector('[data-nav]');

  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      nav.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
